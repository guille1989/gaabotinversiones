# Copia este fichero como .env y rellénalo. El .env NUNCA se sube a git.

# --- Claves de API del exchange (Kraken) ---
# Créalas SIN permiso de retirada (withdraw). Solo: consultar saldos/órdenes y operar.
# En paper no hacen falta: los precios se leen de la API pública.
GAA_API_KEY=
GAA_API_SECRET=

# --- Cerrojo del modo real ---
# Para operar con dinero real esto debe valer exactamente "si", ADEMÁS de poner
# modo: real en config/config.yaml y confirmar a mano al arrancar.
GAA_PERMITIR_REAL=no

# --- Alertas por Telegram ---
GAA_TELEGRAM_TOKEN=
GAA_TELEGRAM_CHAT_ID=
